# Copy to .env.local for development, and set the same keys in Vercel.
# .env.local is gitignored — the API key must never be committed.

# Absolute origin, no trailing slash. Canonical tags, hreflang and the sitemap
# are only honoured as absolute URLs, so this has to be right in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form -----------------------------------------------------------
# Read only by /api/contact on the server. Never prefix these with
# NEXT_PUBLIC_: that would inline them into the browser bundle, where the key
# is readable by anyone and spendable by anyone.

# From https://resend.com/api-keys. Without it the form returns 503 and the
# page shows the direct email address instead — it fails visibly, not silently.
RESEND_API_KEY=

# Where enquiries land. Defaults to CONTACT.email in src/lib/site.ts.
CONTACT_TO=

# The sending address. Defaults to Resend's shared onboarding@resend.dev,
# which needs no domain verification but will only deliver to the address
# that owns the Resend account. Set this to something at your own domain
# once that domain is verified in Resend:
#   CONTACT_FROM=Portfolio Contact <contact@hassanamini.dev>
CONTACT_FROM=
