# Copy to .env.local for development, and set the same keys in Vercel.
# .env.local is gitignored — credentials must never be committed.

# Absolute origin, no trailing slash. Canonical tags, hreflang and the sitemap
# are only honoured as absolute URLs, so this has to be right in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form -----------------------------------------------------------
# Read only by /api/contact, on the server. Never prefix any of these with
# NEXT_PUBLIC_: that inlines them into the browser bundle, where the
# credential is readable by anyone and spendable by anyone.
#
# Pick ONE transport. If CONTACT_TRANSPORT is unset, SMTP wins when SMTP_HOST
# is set, otherwise Resend when RESEND_API_KEY is set. With neither, the form
# returns 503 and the page shows the direct email address — it fails visibly,
# never silently.
#
#   smtp    any SMTP server — your own domain's mailbox, an Iranian host, or
#           Gmail with an App Password
#   resend  Resend's REST API
#   log     development only; prints the message to the server console and
#           reports success. Refused when NODE_ENV=production.
CONTACT_TRANSPORT=

# --- Option A: SMTP ---
# Works from anywhere and needs no account you cannot open. The connection is
# made by the server the site runs on, so where you develop does not matter.
#
# Gmail:  smtp.gmail.com / 465 / your address / a 16-character App Password
#         (Google Account → Security → 2-Step Verification → App passwords).
#         Your normal password will not work.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# --- Option B: Resend ---
# From https://resend.com/api-keys.
RESEND_API_KEY=

# --- Shared ---
# Where enquiries land. Defaults to CONTACT.email in src/lib/site.ts.
CONTACT_TO=

# The sending address. It must be a mailbox you control: sending as the
# visitor's own address fails SPF and DKIM and lands in spam, which is why
# their address goes in Reply-To instead.
#   SMTP defaults to SMTP_USER.
#   Resend defaults to onboarding@resend.dev, which needs no domain
#   verification but only delivers to the address that owns the account.
CONTACT_FROM=
